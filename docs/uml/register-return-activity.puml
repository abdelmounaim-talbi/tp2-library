
@startuml

|Member|
start
:Return a copy;

|Librarian|
:Scan the barcode;

|System|
if (Barcode readable?) then (yes)
    :Identify the copy;
else (no)
    |Librarian|
    :Enter the inventory number;
    |System|
    :Identify the copy;
endif

if (Copy is on loan?) then (yes)
    :Close the loan;

    if (Return is late?) then (yes)
        :Suspend the member;
    endif

    if (Book reserved?) then (yes)
        :Keep the copy aside;
        :Notify the member by email;
    else (no)
        :Mark the copy as available;
    endif

    :Print the receipt;

else (no)
    :Display error message;
    stop
endif

stop
@enduml
